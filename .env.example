NODE_ENV=development
PORT=4000
# The API connects only through DATABASE_URL. PGHOST, PGUSER, PGPORT, and
# PGDATABASE are kept for npm run db:azure, which rewrites DATABASE_URL from a
# short-lived Microsoft Entra token. PGUSER is the Entra admin, for example
# name@tenant.onmicrosoft.com. Do not commit that generated URL.
PGHOST=db-aro.postgres.database.azure.com
PGUSER=
PGPORT=5432
PGDATABASE=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oouth?schema=public
FRONTEND_ORIGIN=http://localhost:3000,https://corporate-oouth.gfa-health.com
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# VIDEO_TOKEN_SECRET is created by this API. WebRTC and getUserMedia do not issue one.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
VIDEO_TOKEN_SECRET=replace-with-a-long-random-video-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Dummy keys stay in place until Paystack is enabled. Keys containing "dummy" are treated as unset.
PAYSTACK_SECRET_KEY=sk_test_dummy_oouth_not_live
PAYSTACK_PUBLIC_KEY=pk_test_dummy_oouth_not_live
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OOUTH <no-reply@oouth.local>
REDIS_URL=
DEMO_STAFF_PASSWORD="Preview#2026"
# Comma-separated TURN URLs, for example the Metered relay URLs. Leave blank to use STUN only.
# Do not commit real credentials.
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
